POSTGRES_USER=casanest_user
POSTGRES_PASSWORD=casanest_password
POSTGRES_DB=casanest

FRONTEND_URL=https://casanest.my.id
VITE_API_URL=https://casanest.my.id
VITE_RECAPTCHA_SITE_KEY=

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!

# Auth session / Remember me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true on HTTPS production; set false only for plain-http local testing
COOKIE_SECURE=true
MAX_UPLOAD_BYTES=5368709120

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://casanest.my.id/connected-accounts/google/callback
